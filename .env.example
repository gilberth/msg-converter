# =============================================================================
# MSG to EML Converter - Environment Variables
# =============================================================================

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================

# Secret key for Flask sessions (REQUIRED)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Flask environment (development or production)
FLASK_ENV=production

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Enable/disable authentication (true or false)
ENABLE_AUTH=true

# =============================================================================
# GENERIC OIDC CONFIGURATION
# =============================================================================
# Supports: Pocket ID, Authentik, Keycloak, Google, Azure AD, Auth0, and more

# OIDC Provider type (for preset configurations)
# Options: pocketid, authentik, keycloak, google, azure, auth0, generic
OIDC_PROVIDER=pocketid

# OIDC Server URL (without trailing slash)
OIDC_BASE_URL=https://auth.example.com

# OAuth2 Client Credentials (get these from your OIDC provider)
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# OAuth2 Scopes (default: openid email profile)
OIDC_SCOPES=openid email profile

# Allowed Groups (comma-separated, leave empty to allow all authenticated users)
OIDC_ALLOWED_GROUPS=

# Session Lifetime (in hours, default: 24)
SESSION_LIFETIME_HOURS=24

# =============================================================================
# PROVIDER-SPECIFIC SETTINGS
# =============================================================================

# For Authentik: Application slug
OIDC_SLUG=msg-converter

# For Keycloak: Realm name
OIDC_REALM=master

# For Azure AD: Tenant ID (default: common)
OIDC_TENANT=common

# =============================================================================
# CUSTOM OIDC ENDPOINTS (optional - override auto-discovery)
# =============================================================================
# Only needed if your provider doesn't support .well-known/openid-configuration
# or if you need custom endpoint URLs

# OIDC Discovery URL (auto-configures all endpoints)
# OIDC_DISCOVERY_URL=https://auth.example.com/.well-known/openid-configuration

# Manual endpoint configuration (only if discovery doesn't work)
# OIDC_AUTHORIZE_URL=https://auth.example.com/oauth/authorize
# OIDC_TOKEN_URL=https://auth.example.com/oauth/token
# OIDC_USERINFO_URL=https://auth.example.com/oauth/userinfo
# OIDC_LOGOUT_URL=https://auth.example.com/oauth/logout

# =============================================================================
# LEGACY AUTHENTIK CONFIGURATION (backwards compatible)
# =============================================================================
# These variables still work but are deprecated. Use OIDC_* variables instead.

# AUTHENTIK_BASE_URL=https://auth.example.com
# AUTHENTIK_CLIENT_ID=your-client-id
# AUTHENTIK_CLIENT_SECRET=your-client-secret
# AUTHENTIK_SLUG=msg-converter
# AUTHENTIK_REDIRECT_URI=https://your-app.com/callback
# AUTHENTIK_ALLOWED_GROUPS=

# =============================================================================
# PROVIDER CONFIGURATION EXAMPLES
# =============================================================================

# --- POCKET ID ---
# OIDC_PROVIDER=pocketid
# OIDC_BASE_URL=https://pocket-id.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret

# --- AUTHENTIK ---
# OIDC_PROVIDER=authentik
# OIDC_BASE_URL=https://authentik.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_SLUG=msg-converter

# --- KEYCLOAK ---
# OIDC_PROVIDER=keycloak
# OIDC_BASE_URL=https://keycloak.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REALM=your-realm

# --- GOOGLE ---
# OIDC_PROVIDER=google
# OIDC_BASE_URL=https://accounts.google.com
# OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=your-google-client-secret

# --- AZURE AD ---
# OIDC_PROVIDER=azure
# OIDC_BASE_URL=https://login.microsoftonline.com
# OIDC_CLIENT_ID=your-azure-client-id
# OIDC_CLIENT_SECRET=your-azure-client-secret
# OIDC_TENANT=your-tenant-id

# --- AUTH0 ---
# OIDC_PROVIDER=auth0
# OIDC_BASE_URL=https://your-tenant.auth0.com
# OIDC_CLIENT_ID=your-auth0-client-id
# OIDC_CLIENT_SECRET=your-auth0-client-secret

# =============================================================================
# DOCKER: DATABASE CONFIGURATION (for Authentik deployment only)
# =============================================================================

# PostgreSQL password
PG_PASS=your-database-password-here

# PostgreSQL user (default: authentik)
PG_USER=authentik

# PostgreSQL database name (default: authentik)
PG_DB=authentik

# Authentik secret key
AUTHENTIK_SECRET_KEY=your-authentik-secret-key-here

# =============================================================================
# DOCKER: PORT CONFIGURATION
# =============================================================================

# Application port (default: 5000)
APP_PORT=5000

# Authentik HTTP port (default: 9000)
AUTHENTIK_PORT_HTTP=9000

# Authentik HTTPS port (default: 9443)
AUTHENTIK_PORT_HTTPS=9443
