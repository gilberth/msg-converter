# Flask Configuration
SECRET_KEY=your-secret-key-here-generate-a-random-string

# Authentik OAuth2/OIDC Configuration
# Set ENABLE_AUTH=true to enable authentication, false to disable
ENABLE_AUTH=false

# =============================================================================
# OPCIÓN 1: AUTO-CONFIGURACIÓN (Recomendado - Más fácil)
# =============================================================================
# Solo necesitas estos 2 valores para usar el script de auto-configuración:
# 1. URL de tu instancia Authentik
# 2. Token de API de Authentik (crea uno en Directory → Tokens)
#
# Luego ejecuta: python authentik_auto_setup.py
# El script creará automáticamente el Provider y Application en Authentik
# y completará las demás variables automáticamente.

# Token de API de Authentik (para auto-configuración)
# Crea uno en: Directory → Tokens con scopes 'view' y 'write'
AUTHENTIK_API_TOKEN=

# =============================================================================
# OPCIÓN 2: CONFIGURACIÓN MANUAL
# =============================================================================
# Si prefieres configurar manualmente, completa todos estos campos:

# Authentik Server URL (your Authentik instance)
AUTHENTIK_BASE_URL=https://authentik.example.com

# OAuth2 Client Credentials (create an application in Authentik manually)
AUTHENTIK_CLIENT_ID=your-client-id-here
AUTHENTIK_CLIENT_SECRET=your-client-secret-here

# Application Slug (the URL-friendly name of your application in Authentik)
# Example: msg-eml-converter
# You can find this in Authentik: Applications → your app → Slug field
AUTHENTIK_SLUG=your-app-slug-here

# Callback URL (update this with your app's URL)
# For local development: http://localhost:5000/callback
# For production: https://your-app.render.com/callback
AUTHENTIK_REDIRECT_URI=http://localhost:5000/callback

# =============================================================================
# CONFIGURACIÓN OPCIONAL (Ambas opciones)
# =============================================================================

# Optional: Specify allowed groups (comma-separated)
# Leave empty to allow all authenticated users
AUTHENTIK_ALLOWED_GROUPS=

# Session lifetime in hours
SESSION_LIFETIME_HOURS=24
