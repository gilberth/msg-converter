# =============================================================================
# MSG to EML Converter - Environment Variables
# =============================================================================

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================

# Secret key for Flask sessions (REQUIRED)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# Flask environment (development or production)
FLASK_ENV=production

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Enable/disable authentication (true or false)
ENABLE_AUTH=true

# =============================================================================
# AUTHENTIK OAUTH2/OIDC CONFIGURATION
# =============================================================================

# Authentik Server URL (without trailing slash)
# Docker: http://authentik-server:9000
# External: https://auth.example.com
AUTHENTIK_BASE_URL=https://auth.example.com

# OAuth2 Client Credentials
# Get these from: Authentik → Applications → Your App → Provider
AUTHENTIK_CLIENT_ID=your-client-id-here
AUTHENTIK_CLIENT_SECRET=your-client-secret-here

# Application Slug
# Find in: Authentik → Applications → Your App → Slug field
AUTHENTIK_SLUG=msg-converter

# Callback URL
# Development: http://localhost:5000/callback
# Production: https://your-app.com/callback
# Docker (external): http://your-domain.com:5000/callback
AUTHENTIK_REDIRECT_URI=https://your-app.com/callback

# Allowed Groups (comma-separated, leave empty to allow all authenticated users)
AUTHENTIK_ALLOWED_GROUPS=

# Session Lifetime (in hours, default: 24)
SESSION_LIFETIME_HOURS=24

# =============================================================================
# AUTHENTIK API TOKEN (for auto-configuration wizard)
# =============================================================================

# API Token for automatic setup (optional)
# Create in: Authentik → Directory → Tokens
AUTHENTIK_API_TOKEN=your-api-token-here

# =============================================================================
# DOCKER: AUTHENTIK DATABASE CONFIGURATION
# =============================================================================
# Only needed if deploying Authentik with docker-compose.prod.yml

# PostgreSQL password (REQUIRED for Authentik deployment)
PG_PASS=your-database-password-here

# PostgreSQL user (default: authentik)
PG_USER=authentik

# PostgreSQL database name (default: authentik)
PG_DB=authentik

# Authentik secret key (REQUIRED for Authentik deployment)
# Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=your-authentik-secret-key-here

# =============================================================================
# DOCKER: PORT CONFIGURATION
# =============================================================================

# Application port (default: 5000)
APP_PORT=5000

# Authentik HTTP port (default: 9000)
AUTHENTIK_PORT_HTTP=9000

# Authentik HTTPS port (default: 9443)
AUTHENTIK_PORT_HTTPS=9443
